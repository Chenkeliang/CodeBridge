diff --git a/src/NetworkAccessConfig.ts b/src/NetworkAccessConfig.ts
new file mode 100644
--- /dev/null
+++ b/src/NetworkAccessConfig.ts
@@ -0,0 +1,38 @@
+import {RequestError, type SessionConfigOption, type SetSessionConfigOptionRequest} from "@agentclientprotocol/sdk";
+import type {AgentMode} from "./AgentMode";
+import type {SandboxPolicy} from "./app-server/v2";
+
+export const NETWORK_ACCESS_CONFIG_ID = "network_access";
+
+export function initialNetworkAccess(config: Record<string, unknown>): boolean {
+    const sandbox = config["sandbox_workspace_write"];
+    return sandbox !== null && typeof sandbox === "object"
+        && (sandbox as Record<string, unknown>)["network_access"] === true;
+}
+
+export function createNetworkAccessConfigOption(
+    value: boolean,
+    mode: AgentMode,
+    booleanSupported: boolean,
+): SessionConfigOption | undefined {
+    if (!booleanSupported || mode.sandboxPolicy.type === "dangerFullAccess") return undefined;
+    return {
+        id: NETWORK_ACCESS_CONFIG_ID,
+        name: "Allow network access",
+        description: "Allow sandboxed commands to access the network without changing filesystem access. Applies to subsequent turns.",
+        type: "boolean",
+        currentValue: value,
+    };
+}
+
+export function networkAccessValue(params: SetSessionConfigOptionRequest, booleanSupported: boolean): boolean {
+    if (!booleanSupported || params.type !== "boolean" || typeof params.value !== "boolean") {
+        throw RequestError.invalidParams("network_access requires the boolean config capability and a boolean value");
+    }
+    return params.value;
+}
+
+export function sandboxWithNetworkAccess(policy: SandboxPolicy, networkAccess: boolean): SandboxPolicy {
+    if (policy.type !== "workspaceWrite" && policy.type !== "readOnly") return policy;
+    return {...policy, networkAccess};
+}
diff --git a/src/__tests__/NetworkAccessConfig.test.ts b/src/__tests__/NetworkAccessConfig.test.ts
new file mode 100644
--- /dev/null
+++ b/src/__tests__/NetworkAccessConfig.test.ts
@@ -0,0 +1,32 @@
+import {describe, expect, it} from "vitest";
+import {AgentMode} from "../AgentMode";
+import {createNetworkAccessConfigOption, initialNetworkAccess, networkAccessValue, sandboxWithNetworkAccess} from "../NetworkAccessConfig";
+
+describe("ACP network_access configuration", () => {
+    it("defaults to network isolation and accepts only explicit boolean true", () => {
+        expect(initialNetworkAccess({})).toBe(false);
+        expect(initialNetworkAccess({sandbox_workspace_write:{network_access:"true"}})).toBe(false);
+        expect(initialNetworkAccess({sandbox_workspace_write:{network_access:true}})).toBe(true);
+    });
+    it("advertises only after boolean capability negotiation", () => {
+        expect(createNetworkAccessConfigOption(false, AgentMode.Agent, false)).toBeUndefined();
+        expect(createNetworkAccessConfigOption(false, AgentMode.Agent, true)).toMatchObject({id:"network_access",type:"boolean",currentValue:false});
+        expect(createNetworkAccessConfigOption(false, AgentMode.AgentFullAccess, true)).toBeUndefined();
+    });
+    it("validates ACP boolean requests including false", () => {
+        expect(networkAccessValue({sessionId:"session",configId:"network_access",type:"boolean",value:false},true)).toBe(false);
+        expect(() => networkAccessValue({sessionId:"session",configId:"network_access",value:"true"},true)).toThrow();
+        expect(() => networkAccessValue({sessionId:"session",configId:"network_access",type:"boolean",value:true},false)).toThrow();
+    });
+    it("preserves filesystem policy and isolates session settings", () => {
+        const base = AgentMode.Agent.sandboxPolicy;
+        expect(sandboxWithNetworkAccess(base,true)).toEqual({...base,networkAccess:true});
+        expect(sandboxWithNetworkAccess(base,false)).toEqual({...base,networkAccess:false});
+        expect(base).toEqual(AgentMode.Agent.sandboxPolicy);
+        expect(base).toHaveProperty("networkAccess",false);
+    });
+    it("does not alter full access or change read-only filesystem restrictions", () => {
+        expect(sandboxWithNetworkAccess(AgentMode.AgentFullAccess.sandboxPolicy,true)).toBe(AgentMode.AgentFullAccess.sandboxPolicy);
+        expect(sandboxWithNetworkAccess(AgentMode.ReadOnly.sandboxPolicy,true)).toEqual({...AgentMode.ReadOnly.sandboxPolicy,networkAccess:true});
+    });
+});
