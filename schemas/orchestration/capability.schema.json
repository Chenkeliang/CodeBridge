{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codebridge:orchestration:capability:v1",
  "title": "CodeBridge Capability",
  "type": "object",
  "required": ["schema_version", "id", "owner", "risk", "adapters"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "owner": { "type": "string", "minLength": 1 },
    "risk": {
      "type": "string",
      "enum": ["read_only", "workspace_write", "git_write", "production_write"]
    },
    "approval": { "type": "string", "enum": ["none", "required"] },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "type": "string", "enum": ["skill", "mcp", "cli", "http"] },
          "ref": { "type": "string", "minLength": 1 },
          "version": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "environments": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "description": { "type": "string" }
  },
  "additionalProperties": false
}
