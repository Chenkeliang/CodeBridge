{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codebridge:orchestration:workflow:v1",
  "title": "CodeBridge Workflow",
  "type": "object",
  "required": ["schema_version", "workflow_id", "name", "kind", "status", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "workflow_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["guide", "runbook"] },
    "status": { "type": "string", "enum": ["draft", "published", "deprecated"] },
    "description": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "capability": { "type": "string", "minLength": 1 },
        "mode": {
          "type": "string",
          "enum": ["read_only", "workspace_write", "git_write", "production_write", "manual"]
        },
        "approval": { "type": "string", "enum": ["none", "required"] },
        "purpose": { "type": "string" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["when", "next"],
            "properties": {
              "when": { "type": "string", "minLength": 1 },
              "next": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "anyOf": [
            { "required": ["capability"] },
            { "required": ["branches"] },
            { "properties": { "mode": { "const": "manual" } }, "required": ["purpose"] }
          ]
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
